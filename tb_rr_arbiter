`timescale 1ns/1ps

module tb_rr_arbiter;

    reg clk, rst_n;
    reg [3:0] req;
    wire [3:0] grant;
    wire grant_valid;

    reg [1:0] ref_priority;

    integer total_tests, passed_tests, failed_tests;
    integer i, j;

    // DUT
    rr_arbiter dut (
        .clk(clk),
        .rst_n(rst_n),
        .req(req),
        .grant(grant),
        .grant_valid(grant_valid)
    );

    // Clock
    initial begin
        clk = 0;
        forever #5 clk = ~clk;
    end


    // REFERENCE MODEL
 
    task calculate_expected;
        input  [1:0] p;
        input  [3:0] r;
        output [3:0] g;
        output       v;
        output [1:0] next_p;

        integer k, idx;
        reg found;
        begin
            g = 4'b0000;
            v = 0;
            next_p = p;
            found = 0;

            for (k=0; k<4; k=k+1) begin
                idx = p + k;
                if (idx >= 4) idx = idx - 4;

                if (!found) begin
                    case(idx)
                        0: if(r[0]) begin
                               g=4'b0001; v=1; next_p=1; found=1;
                           end
                        1: if(r[1]) begin
                               g=4'b0010; v=1; next_p=2; found=1;
                           end
                        2: if(r[2]) begin
                               g=4'b0100; v=1; next_p=3; found=1;
                           end
                        3: if(r[3]) begin
                               g=4'b1000; v=1; next_p=0; found=1;
                           end
                    endcase
                end
            end
        end
    endtask


    // CHECK ARBITRATION

    task check_arbitration;
        input [3:0] r;
        input [1:0] p;

        reg [3:0] eg;
        reg       ev;
        reg [1:0] ep;
        begin
            calculate_expected(p,r,eg,ev,ep);
            #1;
            total_tests = total_tests + 1;

            if((grant !== eg) || (grant_valid !== ev)) begin
                failed_tests = failed_tests + 1;
                $display("FAIL | priority=%0d req=%b | expected grant=%b valid=%b | actual grant=%b valid=%b",
                          p,r,eg,ev,grant,grant_valid);
            end
            else begin
                passed_tests = passed_tests + 1;
                $display("CHECK %0d | PASS | priority=%0d req=%b | grant=%b valid=%b",
                          total_tests,p,r,grant,grant_valid);
            end
        end
    endtask

 
    // CHECK GRANT LEGALITY

    task check_grant_validity;
        begin
            total_tests = total_tests + 1;

            if((grant & ~req) != 4'b0000) begin
                failed_tests = failed_tests + 1;
                $display("FAIL | Illegal grant: req=%b grant=%b",req,grant);
            end
            else if(grant_valid &&
                    (grant != 4'b0001) &&
                    (grant != 4'b0010) &&
                    (grant != 4'b0100) &&
                    (grant != 4'b1000)) begin
                failed_tests = failed_tests + 1;
                $display("FAIL | Grant is not one-hot: req=%b grant=%b",req,grant);
            end
            else if(grant_valid && grant == 4'b0000) begin
                failed_tests = failed_tests + 1;
                $display("FAIL | grant_valid=1 but grant=0000");
            end
            else if(!grant_valid && grant != 4'b0000) begin
                failed_tests = failed_tests + 1;
                $display("FAIL | grant_valid=0 but grant=%b",grant);
            end
            else begin
                passed_tests = passed_tests + 1;
                $display("CHECK %0d | PASS | legality | req=%b grant=%b valid=%b",
                          total_tests,req,grant,grant_valid);
            end
        end
    endtask


    // APPLY REQUEST

    task apply_request;
        input [3:0] r;
        begin
            req = r;
            #1;
            check_arbitration(req,ref_priority);
            check_grant_validity;
        end
    endtask

 
    // CLOCK TRANSACTION
 
    task clock_transaction;
        reg [3:0] eg;
        reg       ev;
        reg [1:0] ep;
        begin
            calculate_expected(ref_priority,req,eg,ev,ep);
            @(posedge clk);
            #1;
            if(ev)
                ref_priority = ep;
        end
    endtask

  
    // RESET

    task reset_dut;
        begin
            req   = 4'b0000;
            rst_n = 1'b0;
            #2;

            total_tests = total_tests + 1;
            if((grant !== 4'b0000) || (grant_valid !== 1'b0)) begin
                failed_tests = failed_tests + 1;
                $display("FAIL | Reset outputs incorrect: grant=%b valid=%b",
                          grant,grant_valid);
            end
            else begin
                passed_tests = passed_tests + 1;
                $display("CHECK %0d | PASS | reset | grant=%b valid=%b",
                          total_tests,grant,grant_valid);
            end

            ref_priority = 0;
            @(negedge clk);
            rst_n = 1'b1;
            #1;
        end
    endtask

 
    // TEST 1 : RESET
 
    task test_reset;
        begin
            $display("");
            $display("=================================================");
            $display("TEST 1 : RESET");
            $display("=================================================");

            rst_n = 0;
            req   = 0;
            #2;

            if((grant == 0) && (grant_valid == 0))
                $display("PASS | Reset output = grant 0000, valid 0");
            else
                $display("FAIL | Reset output incorrect: grant=%b valid=%b",
                          grant,grant_valid);

            @(negedge clk);
            rst_n = 1;
            ref_priority = 0;
            #1;
        end
    endtask

 
    // TEST 2 : NO REQUEST

    task test_no_request;
        begin
            $display("");
            $display("TEST 2 : NO REQUEST");
            reset_dut;
            apply_request(4'b0000);
            clock_transaction;
        end
    endtask


    // TEST 3 : SINGLE REQUESTS
  
    task test_single_requests;
        begin
            $display("");
            $display("TEST 3 : SINGLE REQUESTS");
            reset_dut;
            apply_request(4'b0001); clock_transaction;
            apply_request(4'b0010); clock_transaction;
            apply_request(4'b0100); clock_transaction;
            apply_request(4'b1000); clock_transaction;
        end
    endtask

 
    // TEST 4 : MULTIPLE REQUESTS

    task test_multiple_requests;
        begin
            $display("");
            $display("TEST 4 : MULTIPLE SIMULTANEOUS REQUESTS");
            reset_dut;
            apply_request(4'b1011); clock_transaction;
            apply_request(4'b1011); clock_transaction;
            apply_request(4'b1011); clock_transaction;
            apply_request(4'b1011); clock_transaction;
        end
    endtask


    // TEST 5 : ALL FOUR REQUESTERS

    task test_all_four;
        begin
            $display("");
            $display("TEST 5 : ALL FOUR REQUESTERS");
            reset_dut;
            for(i=0;i<8;i=i+1) begin
                apply_request(4'b1111);
                clock_transaction;
            end
        end
    endtask


    // TEST 6 : PARTIAL FAIRNESS

    task test_partial_fairness;
        begin
            $display("");
            $display("TEST 6 : PARTIAL FAIRNESS");

            // 0 -> 1 -> 3 -> 0 ...
            reset_dut;
            for(i=0;i<9;i=i+1) begin
                apply_request(4'b1011);
                clock_transaction;
            end

            // 0 -> 2 -> 0 -> 2 ...
            reset_dut;
            for(i=0;i<8;i=i+1) begin
                apply_request(4'b0101);
                clock_transaction;
            end
        end
    endtask

 
    // TEST 7 : REQUEST WITHDRAWAL
 
    task test_withdrawal;
        begin
            $display("");
            $display("TEST 7 : REQUEST WITHDRAWAL");
            reset_dut;
            apply_request(4'b0001); clock_transaction;
            apply_request(4'b0000); clock_transaction;
            apply_request(4'b1000); clock_transaction;
            apply_request(4'b0001); clock_transaction;
        end
    endtask


    // TEST 8 : PRIORITY HOLD

    task test_priority_hold;
        reg [1:0] saved_priority;
        begin
            $display("");
            $display("TEST 8 : PRIORITY HOLD");
            reset_dut;

            apply_request(4'b0100); clock_transaction;
            apply_request(4'b0100); clock_transaction;

            saved_priority = ref_priority;

            apply_request(4'b0000);
            clock_transaction;

            if(ref_priority != saved_priority) begin
                failed_tests = failed_tests + 1;
                $display("FAIL | Priority changed without a grant");
            end
            else
                $display("PASS | Priority held at %0d with no grant",
                          ref_priority);
        end
    endtask


    // TEST 9 : WRAP-AROUND
   
    task test_wraparound;
        begin
            $display("");
            $display("TEST 9 : WRAP-AROUND");
            reset_dut;

            // 0 -> 1 -> 2 -> 3
            apply_request(4'b1111); clock_transaction;
            apply_request(4'b1111); clock_transaction;
            apply_request(4'b1111); clock_transaction;

            // 3 -> 0 -> 1 -> 2
            apply_request(4'b1001); clock_transaction;
            apply_request(4'b1001); clock_transaction;
        end
    endtask


    // TEST 10 : EXHAUSTIVE REQUEST TEST
  
    task test_exhaustive;
        integer p,r;
        begin
            $display("");
            $display("=================================================");
            $display("TEST 10 : EXHAUSTIVE PRIORITY/REQUEST TEST");
            $display("=================================================");

            for(p=0;p<4;p=p+1) begin
                reset_dut;

                // Establish priority through real grants
                for(j=0;j<p;j=j+1) begin
                    req = 4'b1111;
                    #1;
                    check_arbitration(req,ref_priority);
                    clock_transaction;
                end

                if(ref_priority != p[1:0])
                    $display("ERROR | Could not establish priority %0d. Reference=%0d",
                              p,ref_priority);

                // 16 request patterns for each priority
                for(r=0;r<16;r=r+1) begin
                    req = r[3:0];
                    #1;
                    check_arbitration(req,ref_priority);
                    check_grant_validity;
                    clock_transaction;
                end
            end
        end
    endtask

 
    // TEST 11 : DYNAMIC REQUEST PATTERNS

    task test_dynamic_patterns;
        begin
            $display("");
            $display("TEST 11 : DYNAMIC REQUEST PATTERNS");
            reset_dut;

            req=4'b1111; clock_transaction;
            req=4'b0101; clock_transaction;
            req=4'b0010; clock_transaction;
            req=4'b0000; clock_transaction;
            req=4'b1001; clock_transaction;
            req=4'b0110; clock_transaction;
            req=4'b1010; clock_transaction;
            req=4'b0001; clock_transaction;
            req=4'b1100; clock_transaction;
            req=4'b0011; clock_transaction;
        end
    endtask

    
    // TEST 12 : RANDOMIZED REQUEST PATTERNS

    task test_random;
        integer n;
        reg [3:0] random_req;
        begin
            $display("");
            $display("TEST 12 : RANDOMIZED REQUEST PATTERNS");
            reset_dut;

            for(n=0;n<100;n=n+1) begin
                random_req = $random;
                req = random_req;
                #1;
                check_arbitration(req,ref_priority);
                check_grant_validity;
                clock_transaction;
            end
        end
    endtask

  
    // MAIN TEST SEQUENCE
    
    initial begin
        total_tests  = 0;
        passed_tests = 0;
        failed_tests = 0;

        req = 0;
        rst_n = 1;
        ref_priority = 0;

        $dumpfile("rr_arbiter.vcd");
        $dumpvars(0,tb_rr_arbiter);

        test_reset;
        test_no_request;
        test_single_requests;
        test_multiple_requests;
        test_all_four;
        test_partial_fairness;
        test_withdrawal;
        test_priority_hold;
        test_wraparound;
        test_exhaustive;
        test_dynamic_patterns;
        test_random;

        // Final report
        $display("");
        $display("=================================================");
        $display("                 FINAL REPORT");
        $display("=================================================");
        $display("Total checks : %0d",total_tests);
        $display("Passed       : %0d",passed_tests);
        $display("Failed       : %0d",failed_tests);
        $display("=================================================");

        if(failed_tests == 0) begin
            $display("");
            $display("===============================================");
            $display("            VERIFICATION PASSED");
            $display("===============================================");
        end
        else begin
            $display("");
            $display("===============================================");
            $display("            VERIFICATION FAILED");
            $display("===============================================");
        end

        $finish;
    end

endmodule
