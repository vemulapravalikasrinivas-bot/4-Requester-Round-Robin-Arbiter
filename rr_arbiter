module rr_arbiter (
    input        clk,
    input        rst_n,
    input  [3:0] req,
    output reg [3:0] grant,
    output reg       grant_valid
);

    // Indicates where the next round-robin search starts.
    // 0 -> requester 0
    // 1 -> requester 1
    // 2 -> requester 2
    // 3 -> requester 3
    reg [1:0] priority_ptr;

    // Priority pointer to be loaded after a successful grant.
    reg [1:0] next_priority;

    reg [1:0] search_ptr;
    reg       found;
    integer   i;

    // Combinational round-robin arbitration

    always @(*) begin
        // Default outputs
        grant       = 4'b0000;
        grant_valid = 1'b0;

        // By default, keep the current priority.
        next_priority = priority_ptr;

        // Search begins from the current priority.
        search_ptr = priority_ptr;
        found      = 1'b0;

        // Search all four requesters in circular order.
        for (i = 0; i < 4; i = i + 1) begin
            if (!found) begin
                case (search_ptr)

                    // Requester 0
                    2'd0: begin
                        if (req[0]) begin
                            grant         = 4'b0001;
                            grant_valid   = 1'b1;
                            next_priority = 2'd1;
                            found         = 1'b1;
                        end
                        else begin
                            search_ptr = 2'd1;
                        end
                    end

                    // Requester 1
                    2'd1: begin
                        if (req[1]) begin
                            grant         = 4'b0010;
                            grant_valid   = 1'b1;
                            next_priority = 2'd2;
                            found         = 1'b1;
                        end
                        else begin
                            search_ptr = 2'd2;
                        end
                    end

                    // Requester 2
                    2'd2: begin
                        if (req[2]) begin
                            grant         = 4'b0100;
                            grant_valid   = 1'b1;
                            next_priority = 2'd3;
                            found         = 1'b1;
                        end
                        else begin
                            search_ptr = 2'd3;
                        end
                    end

                    // Requester 3
                    2'd3: begin
                        if (req[3]) begin
                            grant         = 4'b1000;
                            grant_valid   = 1'b1;
                            next_priority = 2'd0;
                            found         = 1'b1;
                        end
                        else begin
                            search_ptr = 2'd0;
                        end
                    end

                    default: begin
                        search_ptr = 2'd0;
                    end
                endcase
            end
        end

        // Outputs must remain inactive during reset.
        if (!rst_n) begin
            grant       = 4'b0000;
            grant_valid = 1'b0;
        end
    end

    // Priority pointer state register
    // Active-low asynchronous reset.

    always @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            priority_ptr <= 2'd0;
        end
        else if (grant_valid) begin
            priority_ptr <= next_priority;
        end
    end

endmodule
